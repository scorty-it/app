# Copia questo file in .env e compila i valori:  cp .env.example .env

# Dominio principale: www e gli altri domini in SITI vengono rediretti qui.
DOMINIO=scorty.it

# Indirizzi serviti da Caddy, separati da virgola.
# Server dedicato: Caddy usa le porte 80/443 e ottiene da solo i certificati HTTPS per ogni dominio elencato.
SITI=scorty.it, www.scorty.it
PORTA_HTTP=80
PORTA_HTTPS=443
# Se sul server c'è già un reverse proxy (es. un Caddy di sistema) che gestisce HTTPS, usa invece:
#   SITI=:80
#   PORTA_HTTP=127.0.0.1:8180
#   PORTA_HTTPS=127.0.0.1:8543
# e fai inoltrare scorty.it e www.scorty.it dal proxy di sistema a 127.0.0.1:8180.

# Database PostgreSQL + PostGIS.
# Genera una password con: openssl rand -hex 24
POSTGRES_DB=scorty
POSTGRES_USER=scorty
POSTGRES_PASSWORD=

# Firma dei token anonimi dei dispositivi e delle sfide di calcolo. Almeno 32 caratteri.
# Genera con: openssl rand -hex 32
# Se lo cambi, tutti i telefoni ricevono un nuovo identificativo (perdono la fiducia accumulata).
SEGRETO=

# Titolare del trattamento, mostrato nella pagina Privacy (lo chiede la legge). Sta qui e non nel codice pubblico.
TITOLARE=

# Password del pannello di moderazione (https://tuodominio/admin). Almeno 16 caratteri; vuota = pannello spento.
# Genera con: openssl rand -base64 18
ADMIN_PASSWORD=

# Avvisi a enti e redazioni quando una provincia peggiora: il bot Telegram (token da @BotFather) scrive nel canale
# pubblico della regione, dove dev'essere amministratore. Regioni con il nome ISTAT, separate da virgola.
# Vuoti = niente Telegram, gli avvisi restano nel feed RSS di ogni provincia (/api/province/SA/avvisi.rss).
TELEGRAM_TOKEN=
TELEGRAM_CANALI=
# es. TELEGRAM_CANALI=Campania=@scorty_campania,Puglia=@scorty_puglia,Basilicata=@scorty_basilicata,Calabria=@scorty_calabria,Sicilia=@scorty_sicilia
